default_platform(:mac)

# Path to an App Store Connect API key config (JSON with key_id, issuer_id,
# key). Set ASC_API_KEY_PATH in the gitignored fastlane/.env (fastlane loads
# it automatically) or export it before invoking fastlane.
API_KEY_PATH = ENV["ASC_API_KEY_PATH"]

platform :mac do
  desc "Download current App Store metadata (text only) into ./fastlane/metadata"
  lane :pull_metadata do
    deliver(
      api_key_path: API_KEY_PATH,
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: false,
    )
  end

  desc "Upload metadata to App Store Connect (no binary, no screenshots)"
  lane :push_metadata do
    deliver(
      api_key_path: API_KEY_PATH,
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: false,
    )
  end
end
